{
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://cafe-circulo-production-cc71.up.railway.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://cafe-circulo-production-cc71.up.railway.app/uploads/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
